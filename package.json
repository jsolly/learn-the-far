{
	"name": "learn-the-far",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"worktree:init": "bash scripts/setup-agent-environment.sh",
		"dev": "astro dev --config config/app/astro.mjs",
		"mcp:echarts": "node node_modules/echarts-mcp/src/index.js",
		"build": "astro build --config config/app/astro.mjs",
		"check:ts": "tsc --project config/typescript/tooling.json && astro check --config config/app/astro.mjs --minimumSeverity warning --minimumFailingSeverity warning",
		"check:lint": "biome check --config-path=config/quality/biome.settings.jsonc --error-on-warnings .",
		"check:fix": "biome check --config-path=config/quality/biome.settings.jsonc --write --error-on-warnings .",
		"format": "biome format --config-path=config/quality/biome.settings.jsonc --write .",
		"check:md": "bash scripts/lint-md.sh",
		"check:yaml": "uvx yamllint@1.38.0 -c config/quality/yamllint.yaml --strict .",
		"check:knip": "knip --config config/quality/knip.ts --treat-config-hints-as-errors --treat-tag-hints-as-errors",
		"check:pie": "node scripts/verify-pie-progress.ts",
		"check": "npm run check:lint && npm run check:ts",
		"fix": "npm run check:fix && npm run check:ts",
		"preview": "astro preview --config config/app/astro.mjs",
		"astro": "astro --config config/app/astro.mjs",
		"check:actions": "bash scripts/check-actions.sh && bash scripts/vercel-preview-comment-contract.sh && bash scripts/vercel-preview-workflow-contract.sh && npm run test:preview-workflow",
		"gate": "FLEET_DOC_FAST=0 bash .git-hooks/pre-commit",
		"smoke:production": "node scripts/production-smoke.mjs",
		"smoke:scenario-contract": "node --test scripts/production-smoke-scenario.test.mjs",
		"check:updates": "node tests/update-notice.mjs",
		"test:preview-workflow": "vitest run --config config/testing/vitest.preview.ts",
		"test:unit": "vitest run --config config/testing/vitest.unit.ts",
		"check:a11y": "node scripts/check-accessibility.mjs"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.3",
		"@astrojs/svelte": "^9.0.0",
		"@tailwindcss/vite": "^4.3.1",
		"astro": "^7.0.3",
		"canvas-confetti": "^1.9.4",
		"echarts": "^6.1.0",
		"svelte": "^5.56.4",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@biomejs/biome": "^2.5.14",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.21.0",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "24.13.2",
		"axe-core": "^4.14.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"echarts-mcp": "git+https://github.com/apache/echarts-mcp.git#18b6aa8253231c1df9e3b5baf1991739f4bf0942",
		"knip": "^6.36.0",
		"markdownlint-cli2": "^0.22.1",
		"playwright": "1.63.0",
		"shadcn-svelte": "^1.3.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0",
		"vitest": "5.0.5"
	},
	"overrides": {
		"markdownlint-cli2": {
			"js-yaml": "^4.3.1",
			"markdown-it": "^14.2.0"
		}
	},
	"allowScripts": {
		"canvas@3.2.3": true,
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true
	}
}
