#!/usr/bin/env bash
((BASH_VERSINFO[0] >= 5)) || { echo "✗ $0 requires Bash >= 5, not $BASH_VERSION. Fix: brew install bash; open a fresh shell and rerun repository setup." >&2; exit 1; }
# Repository-owned quality gate; Vercel deploys from main after merge.
set -euo pipefail

# shellcheck source=/dev/null
_repo_owned_gate_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source "$_repo_owned_gate_root/gate/gate-lib.sh"
gate_enter_committing_tree "${BASH_SOURCE[0]}"
if [[ "${GATE_HOOK:-}" == pre-push ]]; then
	trap 'echo "✗ pre-push secrets scan failed — push aborted" >&2' ERR
	gate_pre_push_security "$@"
	exit 0
fi
gate_begin_commit "learn-the-far"
run_step "bash floor" gate_check_bash_floor   # every Bash entrypoint refuses Bash < 5
gate_require_node
gate_npm_ci

# Claude Duet cloud sessions ship no test browser: they set PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD
# and block Playwright's download host (harness-improvements Todoist task 6j3qXFvGP5QhCRP5
# tracks support). There, outside CI, the browser steps below skip with a warning. Anywhere
# else, CI included, a Chromium that cannot launch fails the gate. The opt-out reads as set
# exactly as Playwright and scripts/setup-agent-environment.sh read it.
gate_browser=1
browser_opt_out="${PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD:-}"
if ! browser_error="$(node --input-type=module -e 'try { const { chromium } = await import("playwright"); await (await chromium.launch()).close(); } catch (error) { console.error(String(error?.message ?? error).split("\n")[0]); process.exit(1); }' 2>&1)"; then
	if [[ -z "${CI:-}" && -n "$browser_opt_out" && "$browser_opt_out" != 0 && "$browser_opt_out" != false ]]; then
		gate_browser=0
		echo "⚠ PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=$browser_opt_out and Chromium cannot launch (Claude Duet cloud sessions have no test browser): browser steps skip; CI runs them." >&2
	else
		echo "✗ Playwright Chromium cannot launch: ${browser_error%%$'\n'*}" >&2
		echo "  Fix: npx --no-install playwright install chromium" >&2
		false # fires the gate ERR trap, which prints the abort line and exits
	fi
fi
browser_step() { # browser_step "label" cmd [args...]: run_step unless the browser steps skip here
	if ((gate_browser)); then run_step "$@"; else echo "⚠ skipped: $1 (no test browser here; CI runs it)" >&2; fi
}

run_step "actionlint" npm run check:actions
run_step "lint" npm run check:lint
run_step "knip" npm run check:knip
run_step "markdown lint" npm run check:md
run_step "yaml lint" npm run check:yaml
run_step "zizmor and cfn-lint" bash scripts/security-pre-commit.sh
run_step "pie progress" npm run check:pie
browser_step "negative quiz smoke contract" npm run smoke:scenario-contract
run_step "TypeScript config consumers" node --test tests/config/tsconfig-consumer.test.mjs
run_step "unit tests" npm run test:unit
run_step "astro check (types)" npm run check:ts
run_step "build" npm run build
browser_step "website update browser contract" npm run check:updates
run_step "repository hook trust" bash scripts/repo-python.sh scripts/test-repo-hooks.py

((gate_browser)) || echo "⚠ the browser steps above were skipped; this gate pass does not cover them. CI runs them." >&2
echo "✓ pre-commit gate passed — commit will land; push to a PR, Vercel deploys via GitHub integration on merge."
